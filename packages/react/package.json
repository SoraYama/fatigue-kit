{
  "name": "fatigue-kit-react",
  "version": "1.0.1",
  "description": "React bindings for fatigue-kit frequency capping.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoraYama/fatigue-kit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/SoraYama/fatigue-kit/issues"
  },
  "homepage": "https://sorayama.github.io/fatigue-kit/docs/api/react/",
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "peerDependencies": {
    "fatigue-kit": "^1.0.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
