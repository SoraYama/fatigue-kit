{
  "name": "@fatigue-kit/react",
  "version": "2.0.0",
  "description": "React bindings for fatigue-kit frequency capping.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "peerDependencies": {
    "fatigue-kit": "^1.0.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
