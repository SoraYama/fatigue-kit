---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const image = new URL(`${base}/social-preview.png`, Astro.site)
const chinese = Astro.url.pathname.includes('/zh-cn/')
const alt = chinese
  ? 'fatigue-kit：为自建 UI 组合每天上限、滑动窗口和冷却规则'
  : 'fatigue-kit: daily caps, sliding windows and cooldowns for your own UI'
---
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={alt} />
