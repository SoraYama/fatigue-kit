---
import SharePreview from '../components/SharePreview.astro'
interface Props {
  title: string
  description: string
  locale?: 'en' | 'zh-CN'
}
const { title, description, locale = 'en' } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const localized = locale === 'zh-CN' ? `${base}/zh-cn` : base
const alternate = locale === 'zh-CN' ? base : `${base}/zh-cn`
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12664f" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <SharePreview />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={locale === 'en' ? 'zh-CN' : 'en'} href={new URL(alternate, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <title>{title}</title>
    <script is:inline>
      const theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <nav aria-label="Primary">
        <a class="brand" href={`${localized}/`}>fatigue-kit</a>
        <div>
          <a href={`${localized}/docs/`}>{locale === 'zh-CN' ? '文档' : 'Docs'}</a>
          <a href={`${localized}/playground/`}>Playground</a>
          <a href={`${localized}/roadmap/`}>{locale === 'zh-CN' ? '路线图' : 'Roadmap'}</a>
          <a href={alternate}>{locale === 'zh-CN' ? 'English' : '简体中文'}</a>
          <button id="theme-toggle" type="button" aria-label="Toggle color theme">◐</button>
        </div>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer>
      <span>fatigue-kit · MIT</span>
      <a href="https://github.com/SoraYama/fatigue-kit">GitHub</a>
      <a href="https://www.npmjs.com/package/fatigue-kit">npm</a>
      <a href={`${localized}/docs/project/feedback/`}>{locale === 'zh-CN' ? '求助与反馈' : 'Help and feedback'}</a>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
<style is:global>
  @import '../styles/custom.css';
  * { box-sizing: border-box; }
  html { background: var(--sl-color-black); color: var(--sl-color-white); font-family: var(--sl-font); }
  body { margin: 0; }
  a { color: inherit; }
  .skip { position: fixed; left: 1rem; top: -4rem; z-index: 10; background: var(--sl-color-accent); color: var(--sl-color-black); padding: .75rem; }
  .skip:focus { top: 1rem; }
  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--sl-color-black) 88%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid var(--sl-color-gray-5); }
  .site-header nav, main > section, footer { width: min(76rem, calc(100% - 2rem)); margin-inline: auto; }
  .site-header nav { min-height: 4.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .site-header nav > div { display: flex; align-items: center; gap: 1rem; }
  .site-header a { text-decoration: none; }
  .brand { font-weight: 800; letter-spacing: -.04em; }
  #theme-toggle { border: 1px solid var(--sl-color-gray-5); background: transparent; color: inherit; border-radius: .4rem; padding: .35rem .5rem; cursor: pointer; }
  footer { display: flex; gap: 1rem; padding-block: 3rem; border-top: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-2); }
  footer span { margin-right: auto; }
  @media (max-width: 42rem) { .site-header nav > div a:nth-child(2), .site-header nav > div a:nth-child(3) { display: none; } footer { flex-wrap: wrap; } }
</style>
