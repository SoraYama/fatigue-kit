{
  "name": "fatigue-kit",
  "version": "1.0.1",
  "description": "Zero-dependency frequency capping (疲劳度控制) for popups, toasts and guides — one composable API across Web, mini-programs, React Native and Node.js.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    ".",
    "packages/*",
    "website"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/global/index.global.js",
  "jsdelivr": "./dist/global/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js",
      "require": "./dist/adapters/memory.cjs"
    },
    "./adapters/local-storage": {
      "types": "./dist/adapters/local-storage.d.ts",
      "import": "./dist/adapters/local-storage.js",
      "require": "./dist/adapters/local-storage.cjs"
    },
    "./adapters/session-storage": {
      "types": "./dist/adapters/session-storage.d.ts",
      "import": "./dist/adapters/session-storage.js",
      "require": "./dist/adapters/session-storage.cjs"
    },
    "./adapters/async-storage": {
      "types": "./dist/adapters/async-storage.d.ts",
      "import": "./dist/adapters/async-storage.js",
      "require": "./dist/adapters/async-storage.cjs"
    },
    "./adapters/weapp": {
      "types": "./dist/adapters/weapp.d.ts",
      "import": "./dist/adapters/weapp.js",
      "require": "./dist/adapters/weapp.cjs"
    },
    "./adapters/alipay": {
      "types": "./dist/adapters/alipay.d.ts",
      "import": "./dist/adapters/alipay.js",
      "require": "./dist/adapters/alipay.cjs"
    },
    "./adapters/node-file": {
      "types": "./dist/adapters/node-file.d.ts",
      "import": "./dist/adapters/node-file.js",
      "require": "./dist/adapters/node-file.cjs"
    },
    "./global": "./dist/global/index.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test smoke",
    "format": "biome check --write src test smoke",
    "size": "size-limit",
    "smoke:package": "node smoke/run.mjs",
    "smoke:react": "node smoke/react.mjs",
    "test:react": "npm test --workspace @fatigue-kit/react",
    "build:react": "npm run build --workspace @fatigue-kit/react",
    "typecheck:react": "npm run typecheck --workspace @fatigue-kit/react",
    "build:website": "npm run build --workspace @fatigue-kit/website",
    "changeset": "changeset",
    "prepublishOnly": "npm run build"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "import": "{ createFatigue }",
      "limit": "3.5 kB"
    },
    {
      "name": "web adapter",
      "path": "dist/adapters/local-storage.js",
      "import": "{ localStorageAdapter }",
      "limit": "4 kB"
    },
    {
      "name": "weapp adapter",
      "path": "dist/adapters/weapp.js",
      "import": "{ weappAdapter }",
      "limit": "4 kB"
    }
  ],
  "keywords": [
    "frequency-capping",
    "fatigue",
    "疲劳度",
    "popup",
    "toast",
    "rate-limit",
    "cooldown",
    "mini-program",
    "weapp",
    "react-native",
    "storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoraYama/fatigue-kit.git"
  },
  "bugs": {
    "url": "https://github.com/SoraYama/fatigue-kit/issues"
  },
  "homepage": "https://github.com/SoraYama/fatigue-kit#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^27.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
